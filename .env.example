# Hostinger (use host, user, db from hPanel → Databases):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
DATABASE_URL="mysql://root:@localhost:3306/travelling_dreams"

NEXTAUTH_SECRET="change-me-in-production"
