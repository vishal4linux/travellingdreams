generator client {
  provider   = "prisma-client-js"
  // Binary engine is more stable on Hostinger SSH / shared Linux (avoids library-engine panics).
  engineType   = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Auth & users ───────────────────────────────────────────────────────────

enum StaffRole {
  ADMIN
  HOTEL_MANAGER
  BOOKING_MANAGER
  CONTENT_MANAGER
}

model Role {
  id          String    @id @default(cuid())
  name        StaffRole @unique
  description String?
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([roleId])
}

model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String
  isGuest      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hotelBookings    HotelBooking[]
  packageBookings  PackageBooking[]
  reviews          Review[]
  passwordResetTokens PasswordResetToken[]

  @@index([phone])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Destinations ───────────────────────────────────────────────────────────

model Destination {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  state           String?
  country         String   @default("India")
  tagline         String?
  description     String?  @db.Text
  heroImage       String?
  cardImage       String?
  isPopular       Boolean  @default(false)
  sortOrder       Int      @default(0)
  metaTitle       String?
  metaDescription String?  @db.Text
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotels              Hotel[]
  packageDestinations PackageDestination[]
  enquiries           Enquiry[]

  @@index([isPopular, sortOrder])
  @@index([isPublished])
}

// ─── Hotels ─────────────────────────────────────────────────────────────────

enum PropertyType {
  HOTEL
  RESORT
  BOUTIQUE
  HOMESTAY
  VILLA
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  MAP
  AP
  AI
}

model Amenity {
  id       String          @id @default(cuid())
  name     String          @unique
  icon     String?
  category String?
  hotels   HotelAmenity[]
  rooms    RoomAmenity[]
}

model Hotel {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  destinationId     String
  destination       Destination  @relation(fields: [destinationId], references: [id])
  brandPartner      String?      @default("LA Riqueza Hotels")
  isLaRiqueza       Boolean      @default(false)
  isFeatured        Boolean      @default(false)
  propertyType      PropertyType @default(HOTEL)
  starRating        Int          @default(3)
  address           String
  city              String
  state             String
  latitude          Float?
  longitude         Float?
  shortDescription  String?      @db.Text
  description       String?      @db.Text
  checkInTime       String       @default("14:00")
  checkOutTime      String       @default("11:00")
  policies          String?      @db.Text
  guestRating       Float?
  reviewCount       Int          @default(0)
  metaTitle         String?
  metaDescription   String?      @db.Text
  isPublished       Boolean      @default(true)
  isBookable        Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  images      HotelImage[]
  amenities   HotelAmenity[]
  roomTypes   RoomType[]
  reviews     Review[]
  attractions NearbyAttraction[]
  bookings    HotelBooking[]

  @@index([destinationId])
  @@index([isLaRiqueza, isFeatured])
  @@index([isPublished])
  @@index([city, state])
}

model HotelImage {
  id        String  @id @default(cuid())
  hotelId   String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([hotelId, sortOrder])
}

model HotelAmenity {
  hotelId   String
  amenityId String
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model NearbyAttraction {
  id          String @id @default(cuid())
  hotelId     String
  hotel       Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  distanceKm  Float?
  description String?
}

// ─── Rooms & inventory ──────────────────────────────────────────────────────

model RoomType {
  id               String   @id @default(cuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?  @db.Text
  maxAdults        Int      @default(2)
  maxChildren      Int      @default(1)
  bedType          String?
  roomSizeSqm      Float?
  totalRooms       Int      @default(1)
  baseRate         Decimal  @db.Decimal(12, 2)
  discountedRate   Decimal? @db.Decimal(12, 2)
  mealPlan         MealPlan @default(BREAKFAST)
  extraAdultCharge Decimal  @default(0) @db.Decimal(12, 2)
  extraChildCharge Decimal  @default(0) @db.Decimal(12, 2)
  taxPercent       Decimal  @default(12) @db.Decimal(5, 2)
  cancellationPolicy String? @db.Text
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images     RoomImage[]
  amenities  RoomAmenity[]
  inventory  RoomInventory[]
  rates      RoomRate[]
  hotelBookings HotelBooking[]

  @@unique([hotelId, slug])
  @@index([hotelId])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)

  @@index([roomTypeId])
}

model RoomAmenity {
  roomTypeId String
  amenityId  String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
}

/// Date-based availability (available count per night)
model RoomInventory {
  id           String   @id @default(cuid())
  roomTypeId   String
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  available    Int
  isBlocked    Boolean  @default(false)
  blockReason  String?

  @@unique([roomTypeId, date])
  @@index([roomTypeId, date])
  @@index([date])
}

model RoomRate {
  id           String   @id @default(cuid())
  roomTypeId   String
  roomType     RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  rate         Decimal  @db.Decimal(12, 2)
  extraAdult   Decimal? @db.Decimal(12, 2)
  extraChild   Decimal? @db.Decimal(12, 2)

  @@index([roomTypeId, startDate, endDate])
}

// ─── Packages ───────────────────────────────────────────────────────────────

enum PackageTheme {
  ADVENTURE
  HONEYMOON
  FAMILY
  SPIRITUAL
  HERITAGE
  WEEKEND
  CUSTOM
}

enum HotelCategory {
  STANDARD
  DELUXE
  SUPER_DELUXE
  LUXURY
}

model Package {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  primarySlugPath  String?
  durationNights   Int
  durationDays     Int
  startingCity     String?
  placesCovered    String?       @db.Text
  hotelCategory    HotelCategory @default(DELUXE)
  meals            String?
  transport        String?
  highlights       String?       @db.Text
  description      String?       @db.Text
  inclusions       String?       @db.Text
  exclusions       String?       @db.Text
  cancellationPolicy String?     @db.Text
  terms            String?       @db.Text
  basePrice        Decimal       @db.Decimal(12, 2)
  theme            PackageTheme  @default(ADVENTURE)
  rating           Float?
  reviewCount      Int           @default(0)
  heroImage        String?
  metaTitle        String?
  metaDescription  String?       @db.Text
  isPublished      Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images       PackageImage[]
  destinations PackageDestination[]
  itinerary    PackageItinerary[]
  dates        PackageDepartureDate[]
  prices       PackagePrice[]
  faqs         PackageFaq[]
  bookings     PackageBooking[]

  @@index([isPublished, isFeatured])
  @@index([theme])
}

model PackageImage {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([packageId])
}

model PackageDestination {
  packageId     String
  destinationId String
  package       Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)

  @@id([packageId, destinationId])
}

model PackageItinerary {
  id              String  @id @default(cuid())
  packageId       String
  package         Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayNumber       Int
  title           String
  description     String  @db.Text
  meals           String?
  stay            String?
  locationName    String?
  latitude        Float?
  longitude       Float?
  hotelSlug       String?
  destinationSlug String?
  imageUrl        String?

  @@unique([packageId, dayNumber])
  @@index([packageId])
}

model PackageDepartureDate {
  id        String   @id @default(cuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  seats     Int      @default(20)
  booked    Int      @default(0)

  packageBookings PackageBooking[]

  @@index([packageId, startDate])
}

model PackagePrice {
  id            String        @id @default(cuid())
  packageId     String
  package       Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  label         String?
  seasonStart   DateTime?     @db.Date
  seasonEnd     DateTime?     @db.Date
  hotelCategory HotelCategory?
  vehicleType   String?
  adultPrice    Decimal       @db.Decimal(12, 2)
  childPrice    Decimal       @db.Decimal(12, 2)
  minAdults     Int           @default(1)

  @@index([packageId])
}

model PackageFaq {
  id        String  @id @default(cuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)

  @@index([packageId])
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  PAYMENT_PENDING
  PAID
  CANCELLED
  COMPLETED
  REFUNDED
}

enum BookingType {
  HOTEL
  PACKAGE
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  type          BookingType
  status        BookingStatus @default(PENDING)
  adminNotes    String?       @db.Text
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  couponId      String?
  coupon        Coupon?       @relation(fields: [couponId], references: [id])
  cancellationRequestedAt DateTime?
  cancellationReason      String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hotelBooking   HotelBooking?
  packageBooking PackageBooking?
  guests         BookingGuest[]
  payments       Payment[]

  @@index([status])
  @@index([createdAt])
  @@index([bookingNumber])
}

model HotelBooking {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id])
  roomTypeId   String
  roomType     RoomType  @relation(fields: [roomTypeId], references: [id])
  checkIn      DateTime  @db.Date
  checkOut     DateTime  @db.Date
  rooms        Int       @default(1)
  adults       Int
  children     Int       @default(0)
  guestName    String
  guestEmail   String
  guestPhone   String
  specialRequests String? @db.Text

  @@index([customerId])
  @@index([hotelId])
  @@index([checkIn, checkOut])
}

model PackageBooking {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  packageId       String
  package         Package   @relation(fields: [packageId], references: [id])
  departureDateId String?
  departureDate   PackageDepartureDate? @relation(fields: [departureDateId], references: [id])
  travelDate      DateTime  @db.Date
  adults          Int
  children        Int       @default(0)
  addOns          Json?
  guestName       String
  guestEmail      String
  guestPhone      String
  specialRequests String?   @db.Text

  @@index([customerId])
  @@index([packageId])
  @@index([travelDate])
}

model BookingGuest {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  name      String
  age       Int?
  isChild   Boolean @default(false)

  @@index([bookingId])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  OTHER
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  method          PaymentMethod?
  provider        String        @default("razorpay")
  providerOrderId String?
  providerPaymentId String?
  isAdvance       Boolean       @default(false)
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([providerPaymentId])
}

// ─── Marketing & content ────────────────────────────────────────────────────

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("PERCENT")
  discountValue Decimal   @db.Decimal(12, 2)
  minAmount     Decimal?  @db.Decimal(12, 2)
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  image       String?
  linkUrl     String?
  badge       String?
  validFrom   DateTime?
  validUntil  DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

enum TripType {
  FAMILY
  COUPLE
  HONEYMOON
  FRIENDS
  ADVENTURE
  SOLO
  CORPORATE
  PILGRIMAGE
}

model Enquiry {
  id                 String       @id @default(cuid())
  type               String       @default("CUSTOM_TRIP")
  name               String
  phone              String
  email              String
  destinationId      String?
  destination        Destination? @relation(fields: [destinationId], references: [id])
  destinationText    String?
  travelDateFrom     DateTime?    @db.Date
  travelDateTo       DateTime?    @db.Date
  flexibleDates      Boolean      @default(false)
  adults             Int?
  children           Int?
  startingCity       String?
  numberOfDays       Int?
  budget             String?
  hotelCategory      HotelCategory?
  transportPreference String?
  tripType           TripType?
  specialRequirements String?     @db.Text
  packageId          String?
  status             String       @default("NEW")
  adminNotes         String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status, createdAt])
}

model Review {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  hotelId    String?
  hotel      Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  body       String    @db.Text
  tripType   String?
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([hotelId, isApproved])
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  location  String?
  rating    Int     @default(5)
  trip      String?
  review    String  @db.Text
  avatarUrl String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([isActive, sortOrder])
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.Text
  coverImage      String?
  author          String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?   @db.Text
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  folder    String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([folder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
